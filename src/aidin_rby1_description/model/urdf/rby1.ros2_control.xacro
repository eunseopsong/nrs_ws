<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="robot_ip" default=""/>
    <xacro:arg name="use_impedance_control" default="false"/>
    <xacro:arg name="arm_stiffness" default="100.0"/>
    <xacro:arg name="arm_torque_limit" default="10.0"/>
    <xacro:arg name="torso_stiffness" default="100.0"/>
    <xacro:arg name="torso_torque_limit" default="10.0"/>
    <xacro:arg name="damping_ratio" default="1.0"/>

    <xacro:macro name="rby1_ros2_control" params="virtual_mode initial_positions_file robot_ip">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="rby1_hardware" type="system">
            <hardware>
                <xacro:if value="${virtual_mode}">
                    <plugin>aidin_rby1_hardware/AidinRBY1VirtualHardware</plugin>
                </xacro:if>
                <xacro:unless value="${virtual_mode}">
                  <plugin>aidin_rby1_hardware/RBY1HardwareInterface</plugin>
                  <param name="robot_ip">${robot_ip}</param>
                  <param name="use_impedance_control">$(arg use_impedance_control)</param>
                  <param name="arm_stiffness">$(arg arm_stiffness)</param>
                  <param name="arm_torque_limit">$(arg arm_torque_limit)</param>
                  <param name="torso_stiffness">$(arg torso_stiffness)</param>
                  <param name="torso_torque_limit">$(arg torso_torque_limit)</param>
                  <param name="damping_ratio">$(arg damping_ratio)</param>
                </xacro:unless>
            </hardware>

            <!-- joint  wheel -->
            <joint name="right_wheel">
                <!-- Controllers may request either position or velocity.
                     Export both to avoid interface-mismatch errors. -->
                <command_interface name="position"/>
                <command_interface name="velocity">
                  <param name="min">-1.0</param>
                  <param name="max">1.0</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_wheel']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_wheel">
                <!-- Controllers may request either position or velocity.
                     Export both to avoid interface-mismatch errors. -->
                <command_interface name="position"/>
                <command_interface name="velocity">
                  <param name="min">-1.0</param>
                  <param name="max">1.0</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_wheel']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

            <!-- joint  torso -->
            <joint name="torso_0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['torso_0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="torso_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['torso_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="torso_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['torso_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="torso_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['torso_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="torso_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['torso_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="torso_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['torso_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <!-- joint  right arm -->
            <joint name="right_arm_0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="right_arm_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="right_arm_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="right_arm_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="right_arm_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="right_arm_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="right_arm_6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_arm_6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <!-- joint  left arm -->
            <joint name="left_arm_0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="left_arm_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="left_arm_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="left_arm_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="left_arm_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="left_arm_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="left_arm_6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_arm_6']}</param>                
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <!-- joint  head -->
            <joint name="head_0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['head_0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="head_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['head_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <sensor name="FT_sensor_R">
                <state_interface name="force.x"/>
                <state_interface name="force.y"/>
                <state_interface name="force.z"/>
                <state_interface name="torque.x"/>
                <state_interface name="torque.y"/>
                <state_interface name="torque.z"/>
            </sensor>
            <sensor name="FT_sensor_L">
                <state_interface name="force.x"/>
                <state_interface name="force.y"/>
                <state_interface name="force.z"/>
                <state_interface name="torque.x"/>
                <state_interface name="torque.y"/>
                <state_interface name="torque.z"/>
            </sensor>
            <sensor name="ee_right">
                <state_interface name="position.x"/>
                <state_interface name="position.y"/>
                <state_interface name="position.z"/>
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
            </sensor>
            <sensor name="ee_left">
                <state_interface name="position.x"/>
                <state_interface name="position.y"/>
                <state_interface name="position.z"/>
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
            </sensor>

        </ros2_control>
    </xacro:macro>
</robot>
